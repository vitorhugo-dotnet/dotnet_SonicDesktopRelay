<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The only project allowed a Windows TFM: 10.0.19041 is the minimum that projects
         Windows.Graphics.Capture. Everything else in the solution stays net10.0. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonicDesktopRelay.Media\SonicDesktopRelay.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <!-- The single owner of the FFmpeg download: everything that embeds the runtime references
       this project, so it is acquired once instead of once per consumer. -->
  <Import Project="..\..\build\FFmpegAcquisition.targets" />

</Project>
