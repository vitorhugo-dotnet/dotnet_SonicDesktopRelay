<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SonicDesktopRelay.App"
             xmlns:controls="clr-namespace:SonicDesktopRelay.App.Controls"
             x:Class="SonicDesktopRelay.App.Views.WatchView"
             x:DataType="app:Shell">
    <DockPanel Margin="{StaticResource PagePadding}">
        <StackPanel DockPanel.Dock="Top"
                    Spacing="{StaticResource SpaceMd}"
                    IsVisible="{Binding !IsVideoFullScreen}">
            <TextBlock Text="Watch"
                       FontSize="{StaticResource FontSizeLg}"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Session code"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Name="CodeBox"
                         Width="240"
                         MaxLength="6"
                         PlaceholderText="ABC123"
                         FontSize="{StaticResource FontSizeLg}"
                         FontFamily="Consolas, monospace"
                         TextChanged="OnCodeChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Button Name="WatchButton" Content="Watch" IsEnabled="False" Click="OnWatch" />
                <Button Content="Stop watching"
                        IsEnabled="{Binding ViewModel.CanStop}"
                        Click="OnStop" />
            </StackPanel>

            <TextBlock Text="{Binding ViewModel.StatusText}"
                       FontSize="{StaticResource FontSizeMd}"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock Text="{Binding ShellError}"
                       IsVisible="{Binding ShellError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource DangerBrush}" />

            <TextBlock Text="F11 fills the screen with the picture; Esc comes back."
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8" />
        </StackPanel>

        <controls:VideoSurface Name="Surface" MinHeight="180" />
    </DockPanel>
</UserControl>
