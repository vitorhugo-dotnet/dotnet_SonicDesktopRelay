<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SonicDesktopRelay.App"
             x:Class="SonicDesktopRelay.App.Views.WatchView"
             x:DataType="app:Shell">
    <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <TextBlock Text="Watch"
                   FontSize="{StaticResource FontSizeLg}"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <StackPanel Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="Session code"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Name="CodeBox"
                     Width="240"
                     MaxLength="6"
                     PlaceholderText="ABC123"
                     FontSize="{StaticResource FontSizeLg}"
                     FontFamily="Consolas, monospace"
                     TextChanged="OnCodeChanged" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Button Name="WatchButton" Content="Watch" IsEnabled="False" Click="OnWatch" />
            <Button Content="Stop watching"
                    IsEnabled="{Binding ViewModel.CanStop}"
                    Click="OnStop" />
        </StackPanel>

        <TextBlock Text="{Binding ViewModel.StatusText}"
                   FontSize="{StaticResource FontSizeMd}"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <TextBlock Text="{Binding ShellError}"
                   IsVisible="{Binding ShellError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource DangerBrush}" />

        <TextBlock Text="Joining establishes the session and the signaling socket. No video is received in this build."
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>
</UserControl>
