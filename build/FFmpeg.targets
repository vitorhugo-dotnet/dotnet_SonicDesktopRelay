<Project>

  <!-- Conditional so a project importing both targets files does not define the item
       list twice. -->
  <Import Project="$(MSBuildThisFileDirectory)FFmpeg.props" Condition="'$(FFmpegVersion)' == ''" />

  <!--
    Imported by every project that has to carry the FFmpeg runtime in its own output: the app,
    and the Media.Windows tests. Acquiring the runtime is not done here — see
    FFmpegAcquisition.targets, imported by the one project both of these reference.
  -->

  <!-- Embedding is a build-time fact, so the tests that assert it compile themselves out when
       a build deliberately opts out. -->
  <PropertyGroup Condition="'$(EmbedFFmpegRuntime)' == 'true'">
    <DefineConstants>$(DefineConstants);FFMPEG_RUNTIME_EMBEDDED</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedFFmpegRuntime)' == 'true'">
    <FFmpegRuntimeLibrary Include="@(FFmpegRuntimeLibraryName->'$(FFmpegBinDirectory)%(Identity)')" />
  </ItemGroup>

  <Target Name="VerifyFFmpegRuntime" Condition="'$(EmbedFFmpegRuntime)' == 'true'">
    <ItemGroup>
      <_MissingFFmpegRuntimeLibrary Include="@(FFmpegRuntimeLibrary)"
                                    Condition="!Exists('%(FFmpegRuntimeLibrary.Identity)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingFFmpegRuntimeLibrary)' != ''"
           Text="The FFmpeg runtime to embed is incomplete: @(_MissingFFmpegRuntimeLibrary->'%(Filename)%(Extension)', ', ') missing from $(FFmpegBinDirectory). Delete $(FFmpegCacheRoot) to re-acquire it, point FFmpegRuntimeDirectory at a full FFmpeg $(FFmpegVersion) shared build, or set EmbedFFmpegRuntime=false to build against a system install." />
  </Target>

  <!--
    Beside the app rather than in an ffmpeg subfolder, because that is also where the
    single-file host extracts native libraries to, so one probe order covers both layouts.
  -->
  <Target Name="CopyFFmpegRuntimeToOutputDirectory"
          DependsOnTargets="VerifyFFmpegRuntime"
          AfterTargets="Build"
          Condition="'$(EmbedFFmpegRuntime)' == 'true'"
          Inputs="@(FFmpegRuntimeLibrary)"
          Outputs="@(FFmpegRuntimeLibrary->'$(OutDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(FFmpegRuntimeLibrary)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(FFmpegLicensePath)"
          DestinationFiles="$(OutDir)FFMPEG-LICENSE.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(FFmpegLicensePath)')" />
  </Target>

  <!--
    AssetType 'native' is what makes IncludeNativeLibrariesForSelfExtract pick these up, so the
    single-file EXE carries FFmpeg too instead of only the portable folder having it.
  -->
  <Target Name="AddFFmpegRuntimeToPublishList"
          DependsOnTargets="VerifyFFmpegRuntime"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(EmbedFFmpegRuntime)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(FFmpegRuntimeLibrary)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <AssetType>native</AssetType>
        <PostprocessAssembly>false</PostprocessAssembly>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(FFmpegLicensePath)" Condition="Exists('$(FFmpegLicensePath)')">
        <RelativePath>FFMPEG-LICENSE.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
