<Project>

  <!--
    Where the bundled FFmpeg runtime comes from.

    SonicDesktopRelay ships the FFmpeg 8.1 shared libraries inside its own build output so a
    machine that has never heard of FFmpeg can still share and watch a screen. Nothing is
    downloaded on the user's machine: the acquisition below happens once on the build agent
    and the resulting DLLs travel in the ZIP and inside the single-file EXE.
  -->
  <PropertyGroup>
    <!-- Set to false to build against a system-installed FFmpeg instead (see FFmpeg.targets). -->
    <EmbedFFmpegRuntime Condition="'$(EmbedFFmpegRuntime)' == ''">true</EmbedFFmpegRuntime>

    <!--
      8.1.1, shared, from Gyan's official GitHub mirror of the builds the README already tells
      people to install (`winget install Gyan.FFmpeg.Shared`). The URL is versioned rather than
      a "latest" alias, and the archive is checksummed below, so a build is reproducible and a
      swapped upstream file fails loudly instead of shipping.
    -->
    <FFmpegVersion>8.1.1</FFmpegVersion>
    <FFmpegPackageName>ffmpeg-$(FFmpegVersion)-full_build-shared</FFmpegPackageName>
    <FFmpegPackageFileName>$(FFmpegPackageName).zip</FFmpegPackageFileName>
    <FFmpegPackageUrl>https://github.com/GyanD/codexffmpeg/releases/download/$(FFmpegVersion)/$(FFmpegPackageFileName)</FFmpegPackageUrl>
    <FFmpegPackageSha256>4296b396bdfd5fbc3dfc75ab4c8703354a56963232d65c4182993543df2d2f45</FFmpegPackageSha256>

    <!-- Shared by every project that embeds the runtime, and cached by CI as one directory. -->
    <FFmpegCacheRoot Condition="'$(FFmpegCacheRoot)' == ''">$(MSBuildThisFileDirectory)..\artifacts\ffmpeg\</FFmpegCacheRoot>
    <FFmpegCacheRoot>$([MSBuild]::NormalizeDirectory('$(FFmpegCacheRoot)'))</FFmpegCacheRoot>
    <FFmpegArchivePath>$(FFmpegCacheRoot)$(FFmpegPackageFileName)</FFmpegArchivePath>
    <FFmpegExtractRoot>$(FFmpegCacheRoot)$(FFmpegVersion)\</FFmpegExtractRoot>
    <FFmpegStampPath>$(FFmpegExtractRoot)acquired.stamp</FFmpegStampPath>

    <!--
      The folder the DLLs are taken from. Point FFmpegRuntimeDirectory at an existing shared
      build to skip the download entirely — the escape hatch for an offline or air-gapped agent.
    -->
    <FFmpegRuntimeDirectory Condition="'$(FFmpegRuntimeDirectory)' != ''">$([MSBuild]::EnsureTrailingSlash('$(FFmpegRuntimeDirectory)'))</FFmpegRuntimeDirectory>
    <FFmpegBinDirectory Condition="'$(FFmpegRuntimeDirectory)' != ''">$(FFmpegRuntimeDirectory)</FFmpegBinDirectory>
    <FFmpegBinDirectory Condition="'$(FFmpegBinDirectory)' == ''">$(FFmpegExtractRoot)$(FFmpegPackageName)\bin\</FFmpegBinDirectory>

    <!-- FFmpeg is GPLv3 here (see THIRD-PARTY-NOTICES.md), so its licence travels with the
         binaries it covers. Only the archive carries one; a caller-supplied folder may not. -->
    <FFmpegLicensePath>$(FFmpegExtractRoot)$(FFmpegPackageName)\LICENSE</FFmpegLicensePath>
  </PropertyGroup>

  <!--
    Deliberately not the whole bin folder. avfilter (109 MB) and avdevice exist for filter
    graphs and capture devices, neither of which this app touches: it encodes with avcodec,
    scales with swscale, and swresample is there only because avcodec imports it. Adding a
    name here is all it takes if a future code path needs more.
  -->
  <ItemGroup Condition="'$(EmbedFFmpegRuntime)' == 'true'">
    <FFmpegRuntimeLibraryName Include="avcodec-62.dll" />
    <FFmpegRuntimeLibraryName Include="avutil-60.dll" />
    <FFmpegRuntimeLibraryName Include="swresample-6.dll" />
    <FFmpegRuntimeLibraryName Include="swscale-9.dll" />
  </ItemGroup>

</Project>
