<Project>

  <!-- Conditional so a project importing both targets files does not define the item
       list twice. -->
  <Import Project="$(MSBuildThisFileDirectory)FFmpeg.props" Condition="'$(FFmpegVersion)' == ''" />

  <!--
    Imported by exactly one project — SonicDesktopRelay.Media.Windows, which both the app and
    the Media.Windows tests reference — so the download happens once. Two projects racing on
    the same cache file is the failure this single-owner arrangement exists to avoid; because
    a project reference is built before the projects that reference it, everything downstream
    finds the libraries already unpacked.
  -->
  <Target Name="AcquireFFmpegRuntime"
          BeforeTargets="Build;Publish"
          Condition="'$(EmbedFFmpegRuntime)' == 'true'
                     and '$(FFmpegRuntimeDirectory)' == ''
                     and !Exists('$(FFmpegStampPath)')">

    <MakeDir Directories="$(FFmpegCacheRoot);$(FFmpegExtractRoot)" />

    <Message Importance="high" Text="Acquiring FFmpeg $(FFmpegVersion) shared libraries from $(FFmpegPackageUrl)" />

    <DownloadFile SourceUrl="$(FFmpegPackageUrl)"
                  DestinationFolder="$(FFmpegCacheRoot)"
                  DestinationFileName="$(FFmpegPackageFileName)"
                  SkipUnchangedFiles="true"
                  Retries="3"
                  RetryDelayMilliseconds="5000" />

    <GetFileHash Files="$(FFmpegArchivePath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_FFmpegActualSha256" />
    </GetFileHash>

    <!-- A mismatch deletes the archive: leaving it behind would make every later build fail on
         the same bad bytes without ever re-fetching them. -->
    <Delete Files="$(FFmpegArchivePath)"
            Condition="'$(_FFmpegActualSha256.ToLowerInvariant())' != '$(FFmpegPackageSha256.ToLowerInvariant())'" />
    <Error Condition="'$(_FFmpegActualSha256.ToLowerInvariant())' != '$(FFmpegPackageSha256.ToLowerInvariant())'"
           Text="The FFmpeg archive downloaded from $(FFmpegPackageUrl) hashed to $(_FFmpegActualSha256), not the expected $(FFmpegPackageSha256). The download has been deleted; re-run the build to fetch it again, and update FFmpegPackageSha256 in build/FFmpeg.props only if the upstream release genuinely changed." />

    <!--
      Only the four libraries and the licence, out of a 250 MB archive. The pattern list says
      each entry three ways — bare name, recursive glob, full archive path — because the entry
      filter has matched on the file name alone in some MSBuild versions and on the whole
      relative path in others, and a pattern that matches nothing costs nothing.
    -->
    <Unzip SourceFiles="$(FFmpegArchivePath)"
           DestinationFolder="$(FFmpegExtractRoot)"
           SkipUnchangedFiles="true"
           Include="@(FFmpegRuntimeLibraryName->'%(Identity)', ';');@(FFmpegRuntimeLibraryName->'**/%(Identity)', ';');@(FFmpegRuntimeLibraryName->'$(FFmpegPackageName)/bin/%(Identity)', ';');LICENSE;**/LICENSE;$(FFmpegPackageName)/LICENSE" />

    <!-- Belt and braces: if the filter ever stops matching an upstream layout change, take the
         whole archive rather than failing the build over a glob. -->
    <Unzip SourceFiles="$(FFmpegArchivePath)"
           DestinationFolder="$(FFmpegExtractRoot)"
           SkipUnchangedFiles="true"
           Condition="!Exists('$(FFmpegBinDirectory)avcodec-62.dll')" />

    <!-- Written last, so an interrupted or corrupt acquisition is retried, not half-trusted. -->
    <WriteLinesToFile File="$(FFmpegStampPath)"
                      Lines="$(FFmpegPackageFileName) $(FFmpegPackageSha256)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
